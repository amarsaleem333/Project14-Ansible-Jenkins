pipeline {
    agent any

    stages {
        stage('Checkout SCM') {
            steps {
                // Check out the php-todo repository which contains .env.sample and composer.json
                git branch: 'main', url: 'https://github.com/StegTechHub/php-todo.git'
            }
        }

  stage('Prepare Dependencies') {
    steps {
        sh '''
            echo "APP_NAME=Laravel" > .env
            echo "APP_ENV=local" >> .env
            echo "APP_KEY=base64:randomstring1234567890=" >> .env
            echo "APP_DEBUG=true" >> .env
            echo "APP_URL=http://localhost" >> .env
            echo "DB_CONNECTION=mysql" >> .env
            echo "DB_HOST=127.0.0.1" >> .env
            echo "DB_PORT=3306" >> .env
            echo "DB_DATABASE=homestead" >> .env
            echo "DB_USERNAME=homestead" >> .env
            echo "DB_PASSWORD=sePret^i"
            
            mkdir -p bootstrap/cache
            mkdir -p storage/framework/views
            mkdir -p storage/framework/sessions
            mkdir -p storage/framework/cache
        '''
        sh '/usr/local/bin/composer config policy.advisories.block false'
        sh '/usr/bin/php7.2 /usr/local/bin/composer update --ignore-platform-reqs --no-scripts --no-plugins --no-audit'
        sh '/usr/bin/php7.2 artisan migrate'
        sh '/usr/bin/php7.2 artisan db:seed'
        sh '/usr/bin/php7.2 artisan key:generate'
    }
}
        stage('Execute Unit Tests') {
            steps {
                sh './vendor/bin/phpunit'
            }
        }
    }
}